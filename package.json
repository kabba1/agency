{
  "name": "agency-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-contained browser voxel world prototype built with Vite, TypeScript, and Three.js.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx apps/api/src/server.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "npm run typecheck:web && npm run typecheck:launch",
    "typecheck:web": "tsc --noEmit -p tsconfig.json",
    "typecheck:launch": "tsc --noEmit -p tsconfig.node.json",
    "api:smoke": "tsx apps/api/src/smoke.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "@libsql/client": "^0.17.4",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.9.0",
    "three": "^0.171.0",
    "tweetnacl": "^1.0.3",
    "vite": "^6.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/three": "^0.171.0",
    "playwright": "^1.61.1",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  }
}
