{
  "name": "agency-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-contained browser voxel world prototype built with Vite, TypeScript, and Three.js.",
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.171.0",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/three": "^0.171.0",
    "playwright": "^1.61.1",
    "typescript": "^5.7.2"
  }
}
